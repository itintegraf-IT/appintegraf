// ─── Modul Katalog materiálů ────────────────────────────────────────────

model material_categories {
  code                   String                   @id @db.VarChar(20)
  label                  String                   @db.VarChar(100)
  slug                   String?                  @db.VarChar(80)
  sort_order             Int                      @default(0)
  material_subcategories material_subcategories[]
  materials              materials[]

  @@unique([slug], map: "idx_material_categories_slug")
  @@map("material_categories")
}

model material_subcategories {
  id                     Int                      @id @default(autoincrement())
  category_code          String                   @db.VarChar(20)
  parent_id              Int?
  name                   String                   @db.VarChar(255)
  sort_order             Int                      @default(0)
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.DateTime(0)
  updated_at             DateTime                 @updatedAt @db.DateTime(0)
  material_categories    material_categories      @relation(fields: [category_code], references: [code], onDelete: Restrict, onUpdate: NoAction)
  parent                 material_subcategories?  @relation("MaterialSubcategoryTree", fields: [parent_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  children               material_subcategories[] @relation("MaterialSubcategoryTree")
  materials              materials[]

  @@index([category_code], map: "idx_material_subcat_category")
  @@index([parent_id], map: "idx_material_subcat_parent")
  @@map("material_subcategories")
}

model materials {
  id                     Int                      @id @default(autoincrement())
  category_code          String                   @db.VarChar(20)
  subcategory_id         Int?
  name                   String                   @db.VarChar(255)
  code                   String?                  @db.VarChar(100)
  manufacturer           String?                  @db.VarChar(255)
  supplier               String?                  @db.VarChar(255)
  description            String?                  @db.Text
  cas_number               String?                  @db.VarChar(50)
  is_active              Boolean                  @default(true)
  valid_until            DateTime?                @db.DateTime(0)
  issued_at              DateTime?                @db.DateTime(0)
  certificate_valid_until DateTime?               @db.DateTime(0)
  thickness_label        String?                  @db.VarChar(80)
  hex_color              String?                  @db.VarChar(7)
  cmyk_c                 Int?
  cmyk_m                 Int?
  cmyk_y                 Int?
  cmyk_k                 Int?
  notes                  String?                  @db.Text
  legacy_source          String?                  @db.VarChar(30)
  legacy_id              Int?
  created_at             DateTime                 @default(now()) @db.DateTime(0)
  updated_at             DateTime                 @updatedAt @db.DateTime(0)
  material_categories    material_categories      @relation(fields: [category_code], references: [code], onDelete: Restrict, onUpdate: NoAction)
  material_subcategories material_subcategories?  @relation(fields: [subcategory_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  iml_products_foil      iml_products[]            @relation("ImlProductFoil")
  iml_products_color     iml_products[]           @relation("ImlProductColor")
  iml_products_paper     iml_products[]           @relation("ImlProductPaper")
  iml_products_lacquer     iml_products[]           @relation("ImlProductLacquer")

  @@index([category_code], map: "idx_materials_category")
  @@index([subcategory_id], map: "idx_materials_subcategory")
  @@index([name], map: "idx_materials_name")
  @@index([code], map: "idx_materials_code")
  @@index([legacy_source, legacy_id], map: "idx_materials_legacy")
  @@map("materials")
}

