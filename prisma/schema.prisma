  calendar_event_participants calendar_event_participants[]
  users                       users                         @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "calendar_events_ibfk_1")
  departments                 departments?                  @relation(fields: [department_id], references: [id], onUpdate: NoAction, map: "calendar_events_ibfk_2")
  users_deputy                users?                        @relation("calendar_events_deputy", fields: [deputy_id], references: [id], onUpdate: NoAction, map: "calendar_events_deputy_ibfk")

  @@index([department_id], map: "department_id")
  @@index([deputy_id], map: "idx_deputy_id")
  @@index([approval_status], map: "idx_approval_status")
  @@index([created_by], map: "idx_created_by")
  @@index([end_date], map: "idx_end_date")
  @@index([event_type], map: "idx_event_type")
  @@index([start_date], map: "idx_start_date")
}

