  users_primary     users        @relation("calendar_approver_primary", fields: [primary_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "calendar_dept_approvers_primary_fk")
  users_secondary   users?       @relation("calendar_approver_secondary", fields: [secondary_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "calendar_dept_approvers_secondary_fk")
  users_tertiary    users?       @relation("calendar_approver_tertiary", fields: [tertiary_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "calendar_dept_approvers_tertiary_fk")

  @@index([primary_user_id], map: "idx_calendar_dept_approvers_primary")
  @@index([secondary_user_id], map: "idx_calendar_dept_approvers_secondary")
  @@index([tertiary_user_id], map: "idx_calendar_dept_approvers_tertiary")
}

