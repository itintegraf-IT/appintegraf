  users      users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "audit_log_ibfk_1")

  @@index([action], map: "idx_action")
  @@index([module, created_at], map: "idx_audit_log_module_date")
  @@index([created_at], map: "idx_created")
  @@index([module], map: "idx_module")
  @@index([user_id], map: "idx_user")
}

