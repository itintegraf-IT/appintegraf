  phone       String?  @db.VarChar(50)
  email       String?  @db.VarChar(255)
  role        String?  @db.VarChar(100)
  sort_order  Int      @default(0)
  is_primary  Boolean  @default(false)
  created_at  DateTime @default(now()) @db.DateTime(0)

  iml_customers iml_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("iml_customer_contacts")
}

model iml_products {
  id                   Int       @id @default(autoincrement())
  customer_id          Int?
  ig_code              String?   @db.VarChar(100)
  ig_short_name        String?   @db.VarChar(255)
  client_code          String?   @db.VarChar(100)
  client_name          String?   @db.VarChar(255)
  requester            String?   @db.VarChar(255)
  label_shape_code     String?   @db.VarChar(100)
  product_format       String?   @db.VarChar(100)
  format_width_mm      Decimal?  @db.Decimal(8, 2)
  format_height_mm     Decimal?  @db.Decimal(8, 2)
  die_cut_tool_code    String?   @db.VarChar(100)
  assembly_code        String?   @db.VarChar(100)
  positions_on_sheet   Int?
  pieces_per_box       Int?
  pieces_per_pallet    Int?
  foil_type            String?   @db.VarChar(255)
  foil_material_id     Int?
  foil_id              Int?
  color_coverage       String?   @db.VarChar(255)
  color_material_id    Int?
  paper_material_id    Int?
  lacquer_material_id  Int?
  print_note           String?   @db.Text
  image_data           Bytes?    @db.LongBlob
  pdf_data             Bytes?    @db.LongBlob
  has_print_sample     Boolean   @default(false)
  has_print_proof      Boolean   @default(false)
  ean_code             String?   @db.VarChar(50)
  production_notes     String?   @db.Text
  approval_status      String?   @db.VarChar(50)
  approval_date        DateTime? @db.Date
  color_count          Int?
  print_colors_text    String?   @db.VarChar(255)
  cmyk_c_enabled       Boolean   @default(true)
  cmyk_m_enabled       Boolean   @default(true)
  cmyk_y_enabled       Boolean   @default(true)
  cmyk_k_enabled       Boolean   @default(true)
  label_type           String?   @db.VarChar(20)
  realization_log      String?   @db.Text
  internal_note        String?   @db.Text
  last_edited_by       String?   @db.VarChar(255)
  item_status          String?   @db.VarChar(50)
  print_data_version   String?   @db.VarChar(20)
  stock_quantity       Int?
  sku                  String?   @unique @db.VarChar(100)
  is_active            Boolean   @default(true)
  custom_data          Json?     @db.Json
  labels_per_sheet     Int?
  die_cut_id           Int?

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @updatedAt @db.DateTime(0)

  iml_customers       iml_customers?       @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  iml_foils           iml_foils?           @relation(fields: [foil_id], references: [id], onDelete: SetNull)
  iml_die_cuts        iml_die_cuts?        @relation(fields: [die_cut_id], references: [id], onDelete: SetNull)
  iml_order_items     iml_order_items[]
  iml_product_colors  iml_product_colors[]
  iml_product_files   iml_product_files[]
  iml_inquiry_items   iml_inquiry_items[]
  foil_material       materials?           @relation("ImlProductFoil", fields: [foil_material_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  color_material      materials?           @relation("ImlProductColor", fields: [color_material_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  paper_material        materials?           @relation("ImlProductPaper", fields: [paper_material_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  lacquer_material      materials?           @relation("ImlProductLacquer", fields: [lacquer_material_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([customer_id])
  @@index([ig_code])
  @@index([sku])
  @@index([item_status])
  @@index([foil_id])
  @@index([die_cut_id])
  @@index([foil_material_id], map: "idx_iml_products_foil_material")
  @@index([color_material_id], map: "idx_iml_products_color_material")
  @@index([paper_material_id], map: "idx_iml_products_paper_material")
  @@index([lacquer_material_id], map: "idx_iml_products_lacquer_material")
  @@map("iml_products")
}

