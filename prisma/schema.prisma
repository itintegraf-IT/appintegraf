  cislo_do         Int?     @db.Int
  ks               Int      @default(0) @db.Int
  ks_v_krabici     Int      @db.Int
  c_krab_na_palete Int?     @db.Int
  updated_at       DateTime @updatedAt @db.DateTime(0)

  @@unique([job, production], map: "vyroba_box_state_job_production")
  @@index([job])
  @@map("vyroba_box_state")
}

model vyroba_audit {
  id         Int      @id @default(autoincrement())
  job        String   @db.VarChar(50)
  action     String   @db.VarChar(50)
  user_id    Int?     @db.Int
  details    Json?    @db.Json
  created_at DateTime @default(now()) @db.DateTime(0)

  @@index([job, created_at])
  @@map("vyroba_audit")
}

/// Jednorázové tokeny pro obnovu hesla / aktivaci účtu.
/// V DB je uložen pouze SHA-256 hash tokenu, plaintext se posílá pouze v odkazu na e-mail.
model user_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  purpose    String    @db.VarChar(32)
  token_hash String    @db.VarChar(64)
  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)
  ip_created String?   @db.VarChar(45)
  ip_used    String?   @db.VarChar(45)
  created_at DateTime  @default(now()) @db.DateTime(0)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_tokens_user")

  @@unique([token_hash], map: "uq_user_tokens_hash")
  @@index([user_id, purpose], map: "idx_user_tokens_user_purpose")
  @@index([expires_at], map: "idx_user_tokens_expires")
}

model user_totp_backup_codes {
  id         Int       @id @default(autoincrement())
  user_id    Int
  code_hash  String    @db.VarChar(64)
  used_at    DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.DateTime(0)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_totp_backup_user")

  @@index([user_id], map: "idx_totp_backup_user")
  @@index([code_hash], map: "idx_totp_backup_hash")
}

/// Rate limiting pro veřejné endpointy (zapomenuté heslo apod.).
/// Klíč je typicky "action:identifier" (např. "forgot:user:123", "forgot:ip:1.2.3.4").
model rate_limit_hits {
  id           Int      @id @default(autoincrement())
  key          String   @db.VarChar(128)
  window_start DateTime @db.DateTime(0)
  count        Int      @default(1)

  @@unique([key, window_start], map: "uq_rate_limit_key_window")
  @@index([window_start], map: "idx_rate_limit_window")
}

model stitky_templates {
  key           String         @id @db.VarChar(50)
  sheet_key     String         @db.VarChar(50)
  row_start     Int            @default(2)
  row_step      Int            @default(7)
  row_end       Int            @default(49)
  col_start     Int            @default(1)
  col_step      Int            @default(4)
  col_end       Int            @default(6)
  layout_status String         @default("ready") @db.VarChar(20)
  component_key String         @default("standard") @db.VarChar(50)
  sort_order    Int            @default(0)
  stitky_orders stitky_orders[]
}

model stitky_orders {
  id              Int                 @id @default(autoincrement())
  order_number    String              @unique(map: "uq_stitky_order_number") @db.VarChar(50)
  template_key    String              @db.VarChar(50)
  status          String              @default("DRAFT") @db.VarChar(30)
  notes           String?             @db.Text
  created_by      Int
  last_changed_by Int?
  created_at      DateTime            @default(now()) @db.Timestamp(0)
  updated_at      DateTime            @default(now()) @updatedAt @db.Timestamp(0)
  rows            stitky_label_rows[]
  template        stitky_templates    @relation(fields: [template_key], references: [key], onUpdate: Cascade)
  users_creator   users               @relation("stitky_orders_creator", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stitky_orders_creator_fk")
  users_changed   users?              @relation("stitky_orders_changed", fields: [last_changed_by], references: [id], onUpdate: NoAction, map: "stitky_orders_changed_fk")

  @@index([status], map: "idx_stitky_orders_status")
  @@index([created_by], map: "idx_stitky_orders_created_by")
  @@index([template_key], map: "idx_stitky_orders_template")
}

model stitky_label_rows {
  id           Int           @id @default(autoincrement())
  order_id     Int
  row_index    Int           @db.TinyInt
  quantity     Int?
  pack_size    Int?
  text1        String?       @db.VarChar(500)
  text2        String?       @db.VarChar(500)
  text3        String?       @db.VarChar(500)
  prefix       String?       @db.VarChar(50)
  range_from   String?       @db.VarChar(20)
  range_to     String?       @db.VarChar(20)
  barcode_type String?       @db.VarChar(50)
  order        stitky_orders @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stitky_label_rows_order_fk")

  @@unique([order_id, row_index], map: "uq_stitky_row_order_index")
}

model stitky_user_roles {
  user_id Int
  role    String @db.VarChar(20)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stitky_user_roles_user_fk")

  @@id([user_id, role])
}

model stitky_settings {
  key   String @id @db.VarChar(50)
  value String @db.Text
}

// ===== Modul Projekty (port z integraf-pm; DB tabulky prefix projekty_) =====

enum BoardRole {
  ADMIN
  MEMBER
  OBSERVER
}

enum ParentType {
  CARD
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum PersonalTodoStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  boards Board[]

  @@map("projekty_workspace")
}

model Board {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?  @db.Text
  background  String?
  ownerId     Int
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     users         @relation("ProjektyBoardOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  lists     BoardList[]
  members   BoardMember[]
  labels    Label[]

  @@index([workspaceId])
  @@index([ownerId])
  @@map("projekty_board")
}

model BoardMember {
  boardId String
  userId  Int
  role    BoardRole @default(MEMBER)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId])
  @@map("projekty_board_member")
}

model BoardList {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  color     String?
  position  Float
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId, position])
  @@map("projekty_board_list")
}

model Card {
  id          String    @id @default(cuid())
  number      String    @unique
  listId      String
  boardId     String
  title       String
  description String?   @db.Text
  position    Float
  dueDate     DateTime?
  startDate   DateTime?
  completed   Boolean   @default(false)
  cover       String?
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  list             BoardList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  members          CardMember[]
  labels           CardLabel[]
  checklists       Checklist[]
  promotedFromTodo PersonalTodo? @relation("PersonalTodoPromote")

  @@index([boardId, listId, position])
  @@index([dueDate])
  @@map("projekty_card")
}

model PersonalTodo {
  id      String @id @default(cuid())
  ownerId Int
  owner   users  @relation("ProjektyPersonalTodoOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  title       String             @db.VarChar(500)
  description String?            @db.Text
  status      PersonalTodoStatus @default(NOT_STARTED)
  completedAt DateTime?
  dueDate     DateTime?

  archivedAt       DateTime?
  promotedToCardId String?   @unique
  promotedToCard   Card?     @relation("PersonalTodoPromote", fields: [promotedToCardId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, archivedAt, status])
  @@index([ownerId, dueDate])
  @@map("projekty_personal_todo")
}

model CardMember {
  cardId String
  userId Int

  card Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
  @@map("projekty_card_member")
}

model Label {
  id      String @id @default(cuid())
  boardId String
  name    String
  color   String

  board      Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cardLabels CardLabel[]

  @@index([boardId])
  @@map("projekty_label")
}

model CardLabel {
  cardId  String
  labelId String

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
  @@map("projekty_card_label")
}

model Checklist {
  id        String   @id @default(cuid())
  cardId    String
  name      String
  position  Float
  createdAt DateTime @default(now())

  card  Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@index([cardId, position])
  @@map("projekty_checklist")
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  text        String
  done        Boolean   @default(false)
  position    Float
  assigneeId  Int?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignee  users?    @relation("ProjektyChecklistItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([checklistId, position])
  @@index([assigneeId])
  @@map("projekty_checklist_item")
}

model Note {
  id         String     @id @default(cuid())
  parentType ParentType
  parentId   String
  content    String     @db.Text
  authorId   Int?
  mentions   Json?
  createdAt  DateTime   @default(now())

  author users? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([parentType, parentId])
  @@index([authorId])
  @@map("projekty_note")
}

model Attachment {
  id         String     @id @default(cuid())
  parentType ParentType
  parentId   String
  fileName   String
  data       Bytes      @db.LongBlob
  size       Int
  mime       String
  uploadedBy Int?
  createdAt  DateTime   @default(now())

  uploader users? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([parentType, parentId])
  @@map("projekty_attachment")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     Int?
  entityType String
  entityId   String
  action     AuditAction
  diff       Json
  createdAt  DateTime    @default(now())

  user users? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("projekty_audit_log")
}
