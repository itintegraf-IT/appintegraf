// ─── Modul IML (zákazníci, produkty, objednávky) ─────────────────────────────────
model iml_customers {
  id                                Int      @id @default(autoincrement())
  name                              String   @db.VarChar(255)
  email                             String?  @db.VarChar(255)
  phone                             String?  @db.VarChar(50)
  contact_person                    String?  @db.VarChar(255)
  allow_under_over_delivery_percent Decimal? @db.Decimal(5, 2)
  customer_note                     String?  @db.Text
  billing_address                   String?  @db.Text
  shipping_address                  String?  @db.Text
  individual_requirements           String?  @db.Text
  city                              String?  @db.VarChar(100)
  postal_code                       String?  @db.VarChar(20)
  country                           String?  @default("Česká republika") @db.VarChar(100)

  billing_company String? @db.VarChar(255)
  tax_country     String? @db.VarChar(2)
  ico             String? @db.VarChar(32)
  dic             String? @db.VarChar(32)
  label_requirements String? @db.Text
  pallet_packaging   String? @db.Text
  prepress_notes     String? @db.Text

  parent_id  Int?
  unit_type  String @default("standalone") @db.VarChar(20)
  sort_order Int    @default(0)

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @updatedAt @db.DateTime(0)

  parent   iml_customers?  @relation("CustomerHierarchy", fields: [parent_id], references: [id], onDelete: Restrict)
  branches iml_customers[] @relation("CustomerHierarchy")

  iml_products                    iml_products[]
  iml_orders                      iml_orders[]
  iml_customer_shipping_addresses iml_customer_shipping_addresses[]
  iml_inquiries                   iml_inquiries[]
  iml_customer_emails             iml_customer_emails[]
  iml_customer_contacts           iml_customer_contacts[]

  @@index([parent_id])
  @@index([unit_type])
  @@map("iml_customers")
}

model iml_customer_emails {
  id          Int      @id @default(autoincrement())
  customer_id Int
  email       String   @db.VarChar(255)
  kind        String   @default("general") @db.VarChar(30)
  sort_order  Int      @default(0)
  is_primary  Boolean  @default(false)
  created_at  DateTime @default(now()) @db.DateTime(0)

  iml_customers iml_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([customer_id, kind])
  @@map("iml_customer_emails")
}

model iml_customer_contacts {
  id          Int      @id @default(autoincrement())
