  resolver         String         @db.VarChar(50)
  fixed_user_id    Int?
  created_at       DateTime       @default(now()) @db.Timestamp(0)
  updated_at       DateTime       @default(now()) @db.Timestamp(0)
  contract_types   contract_types @relation(fields: [contract_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contract_workflow_steps_type_fk")
  users_fixed      users?         @relation("contract_workflow_steps_fixed_user", fields: [fixed_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "contract_workflow_steps_fixed_fk")

  @@unique([contract_type_id, step_order], map: "uq_contract_workflow_type_step")
  @@index([contract_type_id], map: "idx_contract_workflow_steps_type")
  @@index([resolver], map: "idx_contract_workflow_steps_resolver")
}

model contracts {
  id                  Int                  @id @default(autoincrement())
  title               String               @db.VarChar(500)
  /// Číslo / externí ID smlouvy
  contract_number     String?              @db.VarChar(100)
  party_company       String?              @db.VarChar(255)
  party_contact       String?              @db.VarChar(255)
  contract_type_id    Int
  description         String?              @db.Text
  /// draft | in_approval | approval_completed | signature_pending | signed | archived | rejected | returned
  approval_status     String               @default("draft") @db.VarChar(30)
  value_amount        Decimal?             @db.Decimal(15, 2)
  value_currency      String?              @default("CZK") @db.VarChar(10)
  effective_from      DateTime?            @db.DateTime(0)
  valid_until         DateTime?            @db.DateTime(0)
  expires_at          DateTime?            @db.DateTime(0)
  signed_at           DateTime?            @db.DateTime(0)
  created_by          Int
  responsible_user_id Int?
  department_id       Int?
  created_at          DateTime             @default(now()) @db.Timestamp(0)
  updated_at          DateTime             @default(now()) @db.Timestamp(0)
  contract_types      contract_types       @relation(fields: [contract_type_id], references: [id], onUpdate: NoAction, map: "contracts_contract_type_fk")
  users_created_by    users                @relation("contracts_created_by", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "contracts_created_by_fk")
  users_responsible   users?               @relation("contracts_responsible_user", fields: [responsible_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "contracts_responsible_fk")
  departments         departments?         @relation(fields: [department_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "contracts_department_fk")
  contract_approvals  contract_approvals[]

  @@index([contract_type_id], map: "idx_contracts_type")
  @@index([approval_status], map: "idx_contracts_approval_status")
  @@index([created_by], map: "idx_contracts_created_by")
  @@index([responsible_user_id], map: "idx_contracts_responsible")
  @@index([department_id], map: "idx_contracts_department")
  @@index([valid_until], map: "idx_contracts_valid_until")
  @@index([contract_number], map: "idx_contracts_number")
}

model contract_approvals {
